{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "dev:all": "concurrently -k -n server,vite -c \"#93c5fd,#fdba74\" \"${PHP_BIN:-php} artisan serve\" \"vp dev --host 127.0.0.1\"",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
        "lint:naming": "eslint resources/js"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.7.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.13.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.2",
        "vite-plus": "^0.3.2"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@inertiajs/react": "^3.7.1",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    },
    "overrides": {
        "vite": "$vite"
    }
}
