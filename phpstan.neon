# PHP の型の解析（PHPStan + Larastan）と、規約の自作ルール。実行は composer phpstan。
# ベースライン（phpstan-baseline.neon）は0件。指摘はベースラインに入れずにコードを直す。
# ベースラインは、ライブラリの更新などで一度に多くの指摘が出たときに一時的に使うだけ（作り直しは composer phpstan:baseline）。
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app/

rules:
    - Tests\PHPStan\Rules\NoConditionInArrayValueRule
    - Tests\PHPStan\Rules\NoCountThenFirstRule
